# ============================================================
# FreeFrame on Railway — environment template
# ============================================================
# Copy these variables into your Railway services. Most are shared (set on every
# backend service: api, worker, email_worker, maintenance_worker, beat). A few are
# web-only or per-service. See docs/railway.md for the full walkthrough.
#
# Railway provides managed PostgreSQL and Redis via its plugins — use the
# *internal* URLs they give you (e.g. postgres.railway.internal, redis.railway.internal)
# so the backend services talk over the private network.
#
# S3: Railway has no object-storage plugin, so you must bring your own S3-compatible
# bucket (Cloudflare R2 free tier, AWS S3, Backblaze B2, ...). Configure its CORS to
# allow your FreeFrame origin BEFORE uploading.

# ─── Database (Railway Postgres — internal URL) ─────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=railway
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres.railway.internal:5432/railway

# ─── Redis (Railway Redis — internal URL) ───────────────────
REDIS_URL=redis://default:CHANGE_ME@redis.railway.internal:6379

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_to_a_long_random_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Frontend ───────────────────────────────────────────────
# Your web service's PUBLIC Railway URL, e.g. https://web-production-xxxx.up.railway.app
# (or your custom domain once you set one up).
FRONTEND_URL=https://CHANGE_ME.up.railway.app
# Extra browser origins allowed by CORS, comma-separated. "*" = any origin (dev only).
CORS_ALLOW_ORIGINS=

# ─── S3 Storage (external — Cloudflare R2 / AWS S3 / B2) ────
# Use S3_STORAGE=minio for ANY non-AWS S3-compatible provider (R2, B2, Spaces, MinIO).
# Use S3_STORAGE=s3 only for native AWS S3.
S3_STORAGE=minio
S3_BUCKET=freeframe
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=auto
# For R2 this is https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
# If the browser cannot reach S3_ENDPOINT directly (e.g. a private/custom host),
# set this to the public URL the browser should use for presigned URLs.
# S3_PUBLIC_ENDPOINT=

# ─── Email (REQUIRED for login — magic codes) ───────────────
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=noreply@CHANGE_ME.com
# Leave blank to use the instance branding name.
MAIL_FROM_NAME=
SMTP_HOST=smtp.CHANGE_ME.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
# For AWS SES instead:
# MAIL_PROVIDER=ses
# MAIL_FROM_ADDRESS=noreply@CHANGE_ME.com
# AWS_MAIL_ACCESS_KEY_ID=CHANGE_ME
# AWS_MAIL_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_MAIL_REGION=us-east-1

# ─── Workers & Performance ──────────────────────────────────
API_WORKERS=2
TRANSCODING_CONCURRENCY=1
EMAIL_CONCURRENCY=1
MAINTENANCE_CONCURRENCY=1
TRANSCODER_ENGINE=ffmpeg
MAX_UPLOAD_BYTES=0
SOFT_DELETE_RETENTION_DAYS=30
ORPHAN_SWEEP_GRACE_HOURS=0
ORPHAN_SWEEP_DELETE=false

# ─── Web service ONLY ───────────────────────────────────────
# NEXT_PUBLIC_API_URL stays "/api" (browser talks to the web service's /api path).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_UPLOAD_CONCURRENCY=5
# INTERNAL_API_URL is the build-time target for the /api rewrite -> the backend API.
# Use the private network hostname of your api service (matching its Railway service name).
INTERNAL_API_URL=http://api.railway.internal:8000
